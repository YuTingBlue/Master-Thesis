    if (!is.null(r$invest_opt)) {
      inv_mat <- r$invest_opt
      inv_df_long <- data.frame(tech = rep(r$techs, each = ncol(inv_mat)), Year = rep(1:ncol(inv_mat), times = nrow(inv_mat)), Invest_GW = as.vector(t(inv_mat)))
      for (tch in unique(inv_df_long$tech)) {
        p <- ggplot(inv_df_long %>% dplyr::filter(tech == tch), aes(x = Year, y = Invest_GW)) + geom_line() +
          labs(title = paste("Invest by year -", tch, "-", sc), y = "Invest (GW)") + theme_minimal()
        outfn <- file.path(dir_map$per_tech_plots, paste0("invest_", sc_safe, "_", gsub("[ /]", "_", tch), "_", ts, ".png"))
        safe_save_plot(p, outfn, w = 8, h = 3.5)
      }
    }
  }
}


# --- 6) Save R objects (RDS) for key dataframes if present ---
if (exists("comp_df_all")) safe_save_rds(comp_df_all, file.path(dir_map$rds, paste0("comp_df_all_", ts, ".rds")))
if (exists("cap_df_all")) safe_save_rds(cap_df_all, file.path(dir_map$rds, paste0("cap_df_all_", ts, ".rds")))
if (exists("decomp_df")) safe_save_rds(decomp_df, file.path(dir_map$rds, paste0("decomp_df_", ts, ".rds")))

# --- 7) Zip the entire outputs folder into a single archive ---
zipfile <- file.path(out_dir, paste0("outputs_", ts, ".zip"))
all_files <- list.files(out_dir, recursive = TRUE, full.names = TRUE)

if (length(all_files) == 0) {
  message("No files to zip in ", out_dir)
} else {
  zip_success <- FALSE
  # Prefer 'zip' package (no external binary needed) if available
  if (requireNamespace("zip", quietly = TRUE)) {
    tryCatch({
      zip::zip(zipfile, files = all_files, mode = "cherry-pick")
      message("Created zip using zip::zip: ", zipfile)
      zip_success <- TRUE
    }, error = function(e) message("zip::zip failed: ", e$message))
  }
  # Fallback to utils::zip (may require external zip executable on some systems)
  if (!zip_success) {
    tryCatch({
      # utils::zip expects file paths relative to working dir when using recursive = FALSE
      # Use full paths here; on some systems utils::zip will call an external zip tool.
      utils::zip(zipfile, files = all_files)
      message("Created zip using utils::zip: ", zipfile)
      zip_success <- TRUE
    }, error = function(e) message("utils::zip failed: ", e$message))
  }
  if (!zip_success) {
    message("Failed to create zip archive. Files are still available in the '", out_dir, "' folder.")
  }
}

message("Export + (attempted) compression completed. Check the '", out_dir, "' folder.")

