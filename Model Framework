safe_write_csv <- function(x, filename) {
  if (!is.null(x)) {
    tryCatch({
      write.csv(x, file = filename, row.names = FALSE)
      message("Wrote CSV: ", filename)
    }, error = function(e) message("Failed CSV write: ", filename, " : ", e$message))
