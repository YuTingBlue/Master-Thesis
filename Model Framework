#--------------------- 13. COMPUTE REPLACEMENT VS NET ADDITIONS AND COST COMPONENTS  ---------------------

I_scaled <- I_vec * 1e6   # same scale as in model
scens <- c("With Carbon Fee", "No Carbon Fee")

comp_list <- list()
cap_time_list <- list()

for(sc in scens) {
  r <- results[[sc]]
  inv_mat <- r$invest_opt           # N x T
  X_mat   <- r$X_opt                # N x (T+1)
  
  # replacement required in year t uses capacity at start of t (X[,t])
  replacement <- matrix(0, nrow=nrow(inv_mat), ncol=ncol(inv_mat))
  net_add     <- matrix(0, nrow=nrow(inv_mat), ncol=ncol(inv_mat))
  for(t in 1:T) {
    replacement[,t] <- eta_vec * X_mat[, t]          # GW to replace
    net_add[,t]     <- inv_mat[,t] - replacement[,t] # GW net new (can be negative)
  }
  
  # Per-tech-year cost components
  total_inv_cost_tech <- sweep(inv_mat^2, 1, I_scaled, FUN="*")
  rep_only_cost_tech  <- sweep(replacement^2, 1, I_scaled, FUN="*")
  net_only_cost_tech  <- sweep(net_add^2, 1, I_scaled, FUN="*")
  cross_term_tech     <- sweep(2 * replacement * net_add, 1, I_scaled, FUN="*")
  
  # Sanity check
  check_diff <- colSums(total_inv_cost_tech - (rep_only_cost_tech + cross_term_tech + net_only_cost_tech))
  if(any(abs(check_diff) > 1e-6)) warning("Algebraic decomposition residual not zero")
  
  # Aggregate across technologies
  invest_total_by_year <- colSums(total_inv_cost_tech)
  invest_rep_by_year   <- colSums(rep_only_cost_tech)
  invest_cross_by_year <- colSums(cross_term_tech)
  invest_net_by_year   <- colSums(net_only_cost_tech)
  
  # Defensive share: avoid division by zero
  invest_rep_share <- ifelse(invest_total_by_year > 0, invest_rep_by_year / invest_total_by_year, NA_real_)
  
  comp_df <- data.frame(
    Year = 1:T,
    Scenario = sc,
    Invest_Total = invest_total_by_year,
    Invest_Replacement = invest_rep_by_year,
    Invest_Cross = invest_cross_by_year,
    Invest_Net = invest_net_by_year,
    Invest_Replacement_Share = invest_rep_share,
    stringsAsFactors = FALSE
  )
  comp_list[[sc]] <- comp_df
  
  # capacity totals
  cap_by_year <- data.frame(Year = 0:T, TotalCap_GW = colSums(X_mat), Scenario = sc, stringsAsFactors = FALSE)
  cap_time_list[[sc]] <- cap_by_year
}

