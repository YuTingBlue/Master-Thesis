var_decomp_by_scn <- list()
for (sc in scenarios) {
  r <- results[[sc]]
  # Expect mean_gen_by_tech_year: currently produced as sapply(1:N, function(i) colMeans(...))
  # We want a data.frame tech x Year with mean generation in MWh
  if (is.null(r$mean_gen_by_tech_year)) stop("mean_gen_by_tech_year not found in results for scenario: ", sc)
  
  # r$mean_gen_by_tech_year structure: columns = years, rows = tech index (if using sapply above)
  # Make it explicit as matrix with dims N x T
  # If it's returned as a list or matrix, coerce robustly:
  mg <- as.matrix(r$mean_gen_by_tech_year)  # dimensions might be T x N or N x T
  # Detect orientation: if nrow == T then transpose
  if (nrow(mg) == length(r$mean_sim_cost)) mg <- t(mg)  # make rows = tech, cols = Year
  # Now mg[i, t] = mean generation (GWh) for tech i in year t
  mean_gen_gwh <- mg
  mean_gen_mwh <- mean_gen_gwh * gen_scale  # convert to MWh
  
  # compute per-tech-year variable cost and emission cost
  # c_vec is USD per MWh; emissions is mass per MWh (or per MWh compatible with earlier usage)
  # Make sure c_vec and emissions are in the workspace
  stopifnot(length(c_vec) == nrow(mean_gen_mwh))
  stopifnot(length(emissions) == nrow(mean_gen_mwh))
  
  # variable cost (USD) per tech-year
  var_cost_mat <- sweep(mean_gen_mwh, 1, c_vec, FUN = "*")        # N x T (USD)
  emis_cost_mat <- sweep(mean_gen_mwh, 1, emissions, FUN = "*")   # mass × MWh
  # Convert emission mass to USD using carbon fee for this scenario:
  cf <- ifelse(sc == "With Carbon Fee", CARBON_FEES[1], CARBON_FEES[2])
  emis_cost_usd_mat <- emis_cost_mat * cf                             # USD
  
  # Build tidy data.frame
  df_list <- list()
  Ntech <- nrow(mean_gen_mwh); Tlen <- ncol(mean_gen_mwh)
  tech_names <- results[[sc]]$techs
  for (i in 1:Ntech) {
    df_list[[i]] <- data.frame(
      Scenario = sc,
      Tech = tech_names[i],
      Year = 1:Tlen,
      MeanGen_GWh = mean_gen_gwh[i, ],
      MeanGen_MWh = mean_gen_mwh[i, ],
      VarCost_USD = var_cost_mat[i, ],
      EmisCost_USD = emis_cost_usd_mat[i, ],
      stringsAsFactors = FALSE
    )
  }
  df_var_by_tech <- bind_rows(df_list)
  
  # total variable cost across techs by year
  total_var_by_year <- df_var_by_tech %>% group_by(Year) %>% summarise(TotalVar_USD = sum(VarCost_USD))
  # proportions per tech
  df_var_by_tech <- df_var_by_tech %>% left_join(total_var_by_year, by = "Year") %>%
    mutate(VarShare = ifelse(TotalVar_USD > 0, VarCost_USD / TotalVar_USD, NA_real_))
  
  var_decomp_by_scn[[sc]] <- df_var_by_tech
}

