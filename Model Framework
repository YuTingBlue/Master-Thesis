safe_save_rds <- function(obj, filename) {
  if (!is.null(obj)) {
    tryCatch({
      saveRDS(obj, file = filename)
      message("Saved RDS: ", filename)
    }, error = function(e) message("Failed RDS save: ", filename, " : ", e$message))
