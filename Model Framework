# compute deterministic investment cost per year from invest_opt
get_invest_cost_per_year <- function(scen_res, I_vec) {
  I_scaled <- I_vec * 1e6
  inv_mat <- scen_res$invest_opt      # N x T
  # investment cost per tech/year = I_scaled[i] * invest^2
  inv_cost_by_tech_year <- sweep(inv_mat^2, 1, I_scaled, FUN="*")  # N x T
  colSums(inv_cost_by_tech_year)      # length T
}

# compute emission cost USD per year using mean_sim_emis returned by run_scenario
# (this assumes your run_scenario's mean_sim_emis is in the same mass unit that carbon_fee multiplies)
get_emission_cost_per_year <- function(scen_res, carbon_fee) {
  # if mean_sim_emis is total emission mass per year, multiply by carbon_fee to get USD
  carbon_fee * scen_res$mean_sim_emis
}

# variable (fuel/OM) cost estimated as residual: mean_sim_cost - invest_cost - emission_cost
get_variable_cost_per_year <- function(scen_res, I_vec, carbon_fee) {
  inv_cost <- get_invest_cost_per_year(scen_res, I_vec)
  emis_cost <- get_emission_cost_per_year(scen_res, carbon_fee)
  scen_res$mean_sim_cost - inv_cost - emis_cost
}

